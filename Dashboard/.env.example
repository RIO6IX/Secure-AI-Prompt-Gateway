# Secure AI Prompt Gateway - backend configuration.
# Copy to .env and start the backend with:
#   cd python_gateway
#   python -m uvicorn app:app --host 127.0.0.1 --port 8000 --env-file ../.env
# Every value below is the built-in default unless marked "change".

# --- runtime -------------------------------------------------------------------
ENVIRONMENT=development
# change: at least 32 random characters in production (the app refuses to
# start in production with the default)
JWT_SECRET=local-dev-change-this-secret
TOKEN_TTL_SECONDS=43200
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Default: python_gateway/audit_logs.sqlite3. If you set it, use an absolute
# path; a relative path is resolved from the directory uvicorn runs in.
# DB_PATH=/srv/secure-gateway/audit_logs.sqlite3
LOG_LEVEL=INFO

# --- authentication ------------------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_PBKDF2_ITERATIONS=310000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- local model ---------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# --- detection engine (Component 01) -------------------------------------------
MAX_PROMPT_CHARS=50000
MAX_PROMPT_LENGTH=50000
MAX_BATCH_SIZE=100
MAX_BATCH_TOTAL_CHARS=250000
DEFAULT_MIN_CONFIDENCE=0.35
ENTROPY_THRESHOLD=3.7
ENTROPY_MIN_LENGTH=16
ENTROPY_MAX_LENGTH=256
ENABLE_NER=true
SPACY_MODEL=en_core_web_sm
# Named-entity recognition only covers this many characters; regex,
# checksum and entropy rules always scan the whole prompt.
NER_MAX_CHARS=20000
ENABLE_METRICS=true
# change: salt for correlation hashes
CORRELATION_SALT=local-dev-salt-change-me

# --- sanitization & risk assessment (Component 02) ------------------------------
# Blocked prompts by the same user within this many minutes raise the risk
# of their next sensitive prompt (+10 each, max +30).
RISK_HISTORY_MINUTES=60
# Per-user limit for /gateway/chat, /api/v1/sanitize and /inspect.
PROMPT_RATE_LIMIT_PER_MINUTE=60
# How PII the model repeats is shown in its reply: "mask" (n***@company.lk)
# or "restore" (the requester's original value). Sensitive data the model
# generates itself is always masked.
REPLY_PII_MODE=mask

# --- audit forwarding (optional SIEM) ------------------------------------------
REMOTE_AUDIT_API_URL=
REMOTE_AUDIT_BEARER_TOKEN=
